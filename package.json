{
  "name": "fx-freeplay",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "main": "main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/AceWritesCode/fx-freeplay.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "lint": "eslint .",
    "test": "node --test src/features/session-display/engine/__tests__/sessionEngine.test.ts src/features/session-display/renderer/__tests__/sessionGeometry.test.ts src/features/session-display/engine/__tests__/activeSessionDerivation.test.ts src/features/wrapper/__tests__/wrapperDomain.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "gifenc": "^1.0.3",
    "klinecharts": "^10.0.0-beta3",
    "localforage": "^1.10.0",
    "lucide-react": "^1.21.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.6",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.fxfreeplay.desktop",
    "productName": "FX Freeplay",
    "artifactName": "${name}-setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon-256.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AceWritesCode",
        "repo": "fx-freeplay"
      }
    ]
  }
}
